#: ../../deep_translator.rst:40
msgid "deep\\_translator.detection module"
msgstr "module de détection profonde\\ traducteur"

#: ../../../deep_translator/detection.py:docstring of
#: deep_translator.detection:1
msgid "language detection API"
msgstr "aPI de détection de langue"

#: ../../../deep_translator/detection.py:docstring of
#: deep_translator.detection.batch_detection:1
#: deep_translator.detection.single_detection:1
msgid "function responsible for detecting the language from a text"
msgstr "fonction responsable de la détection de la langue d'un texte"

#: ../../../deep_translator/detection.py:docstring of
#: deep_translator.detection.batch_detection:3
msgid ""
"@param text_list: target batch that you want to detect its language @param "
"api_key: your private API key @param detailed: set to True if you want to "
"get detailed information about the detection process"
msgstr ""
"@param text list: cible batch que vous voulez détecter sa langue @param api "
"key: votre clé d'API privée @param détaillée: défini à True si vous voulez "
"obtenir des informations détaillées sur le processus de détection"

#: ../../../deep_translator/detection.py:docstring of
#: deep_translator.detection.get_request_body:1
msgid "send a request and return the response body parsed as dictionary"
msgstr ""
"envoyer une demande et retourner le corps de réponse analysé comme "
"dictionnaire"

#: ../../../deep_translator/detection.py:docstring of
#: deep_translator.detection.get_request_body:3
msgid ""
"@param text: target text that you want to detect its language @type text: "
"str @type api_key: str @param api_key: your private API key"
msgstr ""
"@param text: texte cible que vous voulez détecter son langage @type text: "
"str @type api key: str @param api key: votre clé d'API privée"

#: ../../../deep_translator/detection.py:docstring of
#: deep_translator.detection.single_detection:3
msgid ""
"@param text: target text that you want to detect its language @type text: "
"str @type api_key: str @param api_key: your private API key @param detailed: "
"set to True if you want to get detailed information about the detection "
"process"
msgstr ""
"@param text: cible text that you want to detect its language @type text: str "
"@type api key: str @param api key: your private API key @param detailed: set "
"to True si vous voulez obtenir des informations détaillées sur le processus "
"de détection"

