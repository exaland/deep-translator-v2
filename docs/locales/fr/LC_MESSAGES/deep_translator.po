"exception thrown if the html element was not found in the body parsed by "
"beautifulsoup"
msgstr ""
"exception lancée si l'élément html n'a pas été trouvé dans le corps analysé "
"par beautifulsoup"

#: ../../../deep_translator/exceptions.py:docstring of
#: deep_translator.exceptions.InvalidSourceOrTargetLanguage:1
#: deep_translator.exceptions.NotValidPayload:1
msgid "exception thrown if the user enters an invalid payload"
msgstr ""
"exception lancée si l'utilisateur entre dans une charge utile non valide"

#: ../../../deep_translator/exceptions.py:docstring of
#: deep_translator.exceptions.LanguageNotSupportedException:1
msgid ""
"exception thrown if the user uses a language that is not supported by the "
"deep_translator"
msgstr ""
"exception lancée si l'utilisateur utilise une langue qui n'est pas supportée "
"par le  traducteur profond"

#: ../../../deep_translator/exceptions.py:docstring of
#: deep_translator.exceptions.MicrosoftAPIerror:1
msgid "exception thrown if Microsoft API returns one of its errors"
msgstr "exception lancée si Microsoft API renvoie une de ses erreurs"

#: ../../../deep_translator/exceptions.py:docstring of
#: deep_translator.exceptions.NotValidLength:1
msgid ""
"exception thrown if the provided text exceed the length limit of the "
"translator"
msgstr ""
"exception lancée si le texte fourni dépasse la limite de longueur du "
"traducteur"

#: ../../../deep_translator/exceptions.py:docstring of
#: deep_translator.exceptions.RequestError:1
#: deep_translator.exceptions.TooManyRequests:1
msgid ""
"exception thrown if an error occurred during the request call, e.g a "
"connection problem."
msgstr ""
"exception lancée si une erreur s'est produite pendant l'appel de requête, "
"par exemple un problème de connexion."

#: ../../../deep_translator/exceptions.py:docstring of
#: deep_translator.exceptions.ServerException:1
msgid "Default YandexTranslate exception from the official website"
msgstr "Par défaut YandexException du site officiel"

#: ../../../deep_translator/exceptions.py:docstring of
#: deep_translator.exceptions.TencentAPIerror:1
msgid "exception thrown if Tencent API returns one of its errors"
msgstr "exception lancée si Tencent API retourne une de ses erreurs"

#: ../../../deep_translator/exceptions.py:docstring of
#: deep_translator.exceptions.TranslationNotFound:1
msgid ""
"exception thrown if no translation was found for the text provided by the "
"user"
msgstr ""
"exception lancée si aucune traduction n'a été trouvée pour le texte fourni "
"par l'utilisateur"

